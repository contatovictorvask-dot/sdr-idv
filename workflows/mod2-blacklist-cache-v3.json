  "nodes": [
    {
      "id": "n01",
      "name": "Cron — A cada 23h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "parameters": {
        "rule": {
