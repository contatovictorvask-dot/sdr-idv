        }
      }
    },
    {
      "id": "n02",
      "name": "Sheets — Blacklist",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [480, 300],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "1f3HHDQwGfb5eTJc6qHj0vBup81gEeBCiOg2awDNss5I",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Blacklist_Permanente",
          "mode": "name"
        },
        "dataStartRow": 2,
        "options": {}
      },
      "credentials": {
        "googleApi": {
          "id": "__CRED_ID__",
          "name": "Google Sheets SDR"
        }
      }
    },
    {
      "id": "n03",
      "name": "Sheets — Quarentena",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [720, 300],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "1f3HHDQwGfb5eTJc6qHj0vBup81gEeBCiOg2awDNss5I",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
