{
  "name": "MOD2 \u2014 Blacklist Cache (Redis)",
  "nodes": [
    {
      "id": "1",
      "name": "Trigger (chamada externa ou cron)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ],
      "parameters": {}
    },
    {
      "id": "2",
      "name": "Verifica cache Redis",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        440,
        300
      ],
      "parameters": {
        "operation": "get",
        "key": "blacklist_cache_ts"
      }
    },
    {
      "id": "3",
      "name": "Cache ainda v\u00e1lido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        640,
        300
      ],
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ Date.now() - ($json['value'] || 0) }}",
              "operation": "smallerEqual",
              "value2": 82800000
            }
          ]
        }
      }
    },
    {
      "id": "4",
      "name": "GET Blacklist (Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        840,
        420
      ],
      "parameters": {
        "operation": "getAll",
        "documentId": "={{ $env.SHEETS_SPREADSHEET_ID }}",
        "sheetName": "={{ $env.SHEETS_TAB_BLACKLIST }}",
        "options": {
          "headerRow": 1
        }
      }
    },
    {
      "id": "5",
      "name": "GET Quarentena (Sheets)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [
        840,
        560
      ],
      "parameters": {
        "operation": "getAll",
        "documentId": "={{ $env.SHEETS_SPREADSHEET_ID }}",
        "sheetName": "={{ $env.SHEETS_TAB_QUARENTENA }}",
        "options": {
          "headerRow": 1
        }
      }
    },
    {
      "id": "6",
      "name": "Monta array unificado + salva Redis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        480
      ],
      "parameters": {
        "jsCode": "// Une Blacklist_Permanente + Quarentena_90_Dias em um \u00fanico Set\nconst blacklistItems  = $('GET Blacklist (Sheets)').all();\nconst quarentenaItems = $('GET Quarentena (Sheets)').all();\n\nconst toSet = arr => arr\n  .map(i => (i.json.username || '').toLowerCase().trim())\n  .filter(Boolean);\n\nconst merged = [...new Set([\n  ...toSet(blacklistItems),\n  ...toSet(quarentenaItems)\n])];\n\n// Salva no staticData para acesso s\u00edncrono dentro do workflow\n$workflow.staticData.blacklistCache    = merged;\n$workflow.staticData.blacklistCachedAt = Date.now();\n\nreturn [{ json: { blacklist: merged, count: merged.length, cachedAt: new Date().toISOString() } }];"
      }
    },
    {
      "id": "7",
      "name": "Redis SET \u2014 blacklist_cache",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1240,
        420
      ],
      "parameters": {
        "operation": "set",
        "key": "blacklist_cache",
        "value": "={{ JSON.stringify($json.blacklist) }}",
        "expire": true,
        "ttl": 86400
      }
    },
    {
      "id": "8",
      "name": "Redis SET \u2014 blacklist_cache_ts",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [
        1240,
        540
      ],
      "parameters": {
        "operation": "set",
        "key": "blacklist_cache_ts",
        "value": "={{ Date.now() }}",
        "expire": true,
        "ttl": 86400
      }
    },
    {
      "id": "9",
      "name": "Retorna resultado",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1440,
        480
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Trigger (chamada externa ou cron)": {
      "main": [
        [
          {
            "node": "Verifica cache Redis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verifica cache Redis": {
      "main": [
        [
          {
            "node": "Cache ainda v\u00e1lido?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cache ainda v\u00e1lido?": {
      "main": [
        [
          {
            "node": "Retorna resultado",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "GET Blacklist (Sheets)",
            "type": "main",
            "index": 0
          },
          {
            "node": "GET Quarentena (Sheets)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET Blacklist (Sheets)": {
      "main": [
        [
          {
            "node": "Monta array unificado + salva Redis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET Quarentena (Sheets)": {
      "main": [
        [
          {
            "node": "Monta array unificado + salva Redis",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Monta array unificado + salva Redis": {
      "main": [
        [
          {
            "node": "Redis SET \u2014 blacklist_cache",
            "type": "main",
            "index": 0
          },
          {
            "node": "Redis SET \u2014 blacklist_cache_ts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Redis SET \u2014 blacklist_cache": {
      "main": [
        [
          {
            "node": "Retorna resultado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveManualExecutions": true
  }
}