# =============================================================================
# SDR PERPÉTUO B2B v2.0 — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha os valores antes de fazer deploy
# NUNCA comite o .env real no repositório
# =============================================================================

# -----------------------------------------------------------------------------
# DOMÍNIOS (sem https://, sem barra no final)
# -----------------------------------------------------------------------------
N8N_HOST=n8n.seudominio.com
EVOLUTION_HOST=evo.seudominio.com

# -----------------------------------------------------------------------------
# SEGURANÇA
# -----------------------------------------------------------------------------
# Redis — senha forte, sem caracteres especiais que quebrem URI
REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE_REDIS

# n8n — Basic Auth (acesso ao editor)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=TROQUE_POR_SENHA_FORTE_N8N

# Evolution API — API Key de autenticação
EVOLUTION_API_KEY=TROQUE_POR_API_KEY_FORTE_EVO

# -----------------------------------------------------------------------------
# INTEGRAÇÕES EXTERNAS (preenchidas nos módulos seguintes)
# -----------------------------------------------------------------------------
# Apify
APIFY_TOKEN=

# Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Google Sheets (Service Account JSON — base64 encoded)
GOOGLE_SERVICE_ACCOUNT_B64=

# WhatsApp — nome da instância criada na Evolution API
EVOLUTION_INSTANCE_NAME=sdr-principal
# Número do WhatsApp para notificações internas (formato: 5511999999999)
NOTIFY_WHATSAPP_NUMBER=
