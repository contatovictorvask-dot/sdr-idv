# =============================================================================
# SDR PERPÉTUO B2B v2.0 — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env e preencha os valores antes de fazer deploy
# NUNCA comite o .env real no repositório
# =============================================================================

# -----------------------------------------------------------------------------
# DOMÍNIOS (sem https://, sem barra no final)
# -----------------------------------------------------------------------------
N8N_HOST=n8n.seudominio.com
EVOLUTION_HOST=evo.seudominio.com

# -----------------------------------------------------------------------------
# SEGURANÇA
# -----------------------------------------------------------------------------
# Redis — senha forte, sem caracteres especiais que quebrem URI
REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE_REDIS

# n8n — Basic Auth (acesso ao editor)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=TROQUE_POR_SENHA_FORTE_N8N

# Evolution API — API Key de autenticação
EVOLUTION_API_KEY=TROQUE_POR_API_KEY_FORTE_EVO

# -----------------------------------------------------------------------------
# INTEGRAÇÕES EXTERNAS
# -----------------------------------------------------------------------------

# Apify (Módulo 3 — Mineração)
APIFY_TOKEN=

# Airtable — IDs já criados (não alterar BASE_ID e TABLE_IDs)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=app9BlRhuDFuRfyHi
AIRTABLE_TABLE_OPERACIONAL=tblr6r7m93b7CcwOS
AIRTABLE_TABLE_CLIENTES=tblOYJaQejTpT5WyR

# Google Sheets — Cold Storage (Service Account)
# Gerar Base64: base64 -w 0 service-account.json
GOOGLE_SERVICE_ACCOUNT_B64=
# ID da planilha SDR_Master_Log (extrair da URL do Google Sheets)
SHEETS_SPREADSHEET_ID=
SHEETS_TAB_BLACKLIST=Blacklist_Permanente
SHEETS_TAB_QUARENTENA=Quarentena_90_Dias
SHEETS_TAB_CLIENTES=Clientes_Ativos_SDR

# WhatsApp — Evolution API
EVOLUTION_INSTANCE_NAME=sdr-principal
# Número para notificações internas (formato: 5511999999999)
NOTIFY_WHATSAPP_NUMBER=
